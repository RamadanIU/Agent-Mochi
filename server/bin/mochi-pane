#!/bin/sh
# Первая панель tmux в терминале Мочи. Запоминаем её tty, pid оболочки, панель и сокет tmux:
# исполнитель агента печатает туда команды агента и их вывод,
# а потом просит readline перерисовать приглашение. Ввод пользователя при этом не теряется.
F="$HOME/.local/state/mochi/term"
mkdir -p "${F%/*}" 2>/dev/null && printf '%s\n' "$(tty)" "$$" "${TMUX_PANE:-}" "${TMUX%,*,*}" > "$F" 2>/dev/null
SH=${MOCHI_SH:-$(command -v bash || echo /bin/sh)}
exec "$SH" -l
