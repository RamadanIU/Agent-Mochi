#!/bin/sh
# Терминал Personal Computer: ttyd от имени personalcomputer-agent.
#  -i  только unix-сокет (в сеть ttyd не смотрит вообще; сокет доступен группе personalcomputer)
#  -H  пускать лишь запросы с X-PersonalComputer-User — его ставит сервер после проверки входа
#  -O  WebSocket только с того же адреса (защита от подключения с чужого сайта)
#  шрифт, размер и цвета здесь не задаём: их ставит страница по теме, а настройки ttyd
#  приходят после подключения и перетёрли бы их
#  -W  разрешить ввод;  -m 5  не больше 5 вкладок;  без -a: аргументы из URL не принимаются
SOCK="${PERSONALCOMPUTER_TTYD_SOCK:-/run/personalcomputer-term/ttyd.sock}"
TTYD="${PERSONALCOMPUTER_TTYD_BIN:-/opt/personalcomputer/bin/ttyd}"
DIR=$(cd "$(dirname "$0")" && pwd)
rm -f "$SOCK"
exec "$TTYD" -i "$SOCK" -b /term -W -O -H X-PersonalComputer-User -m 5 -P 20 \
  -t rendererType=dom -t disableLeaveAlert=true -t disableResizeOverlay=true -t "titleFixed=Personal Computer" \
  "$DIR/personalcomputer-shell"
