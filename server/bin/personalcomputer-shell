#!/bin/sh
# Оболочка терминала Personal Computer (её запускает ttyd от имени personalcomputer-agent).
# tmux держит сессию: закрыл браузер — команды продолжают работать, вернулся — всё на месте.
DIR=$(cd "$(dirname "$0")" && pwd)
cd "$HOME" 2>/dev/null || cd /
export TERM=xterm-256color LANG="${LANG:-C.UTF-8}"
export PATH="$HOME/.local/bin:/opt/personalcomputer/node/bin:$PATH" NPM_CONFIG_PREFIX="$HOME/.local"
# прокси из настроек Personal Computer (HTTP_PROXY, HTTPS_PROXY, NO_PROXY): файл пишет исполнитель агента,
# нет файла — прокси выключен. tmux переносит эти переменные в новые окна (update-environment в tmux.conf)
PX="$HOME/.local/state/personalcomputer/proxy.env"
# shellcheck disable=SC1090
[ -r "$PX" ] && . "$PX"
SH=$(command -v bash || echo /bin/sh)
if command -v tmux >/dev/null 2>&1; then
  # сокет tmux — не в /tmp: у служб он свой (PrivateTmp), а исполнителю агента нужен доступ к панели
  # (путь unix-сокета ограничен ~100 байтами — для слишком длинного $HOME берём /tmp)
  SOCK="$HOME/.local/state/personalcomputer/tmux.sock"
  [ ${#SOCK} -lt 100 ] || SOCK="${TMUX_TMPDIR:-/tmp}/personalcomputer-tmux-$(id -u).sock"
  mkdir -p "$HOME/.local/state/personalcomputer" 2>/dev/null
  PERSONALCOMPUTER_SH="$SH" exec tmux -u -S "$SOCK" -f "$DIR/tmux.conf" new-session -A -s personalcomputer "$DIR/personalcomputer-pane"
fi
exec "$SH" -l
